# 【必須・無料】Gemini APIキー
# https://aistudio.google.com/apikey で取得（クレジットカード登録不要）
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用するモデル（省略可。デフォルトは gemini-2.0-flash）
GEMINI_MODEL=gemini-2.0-flash

# 【任意・無料枠あり】Web検索での補足情報取得（同業他社比較・直近ニュース・口コミ・リスク等）
# 設定しない場合は公式サイトの情報のみで分析します。
# 1. https://programmablesearchengine.google.com/ で検索エンジンを作成し、検索エンジンID(cx)を取得
#    「検索対象: ウェブ全体」に設定してください
# 2. https://console.cloud.google.com/apis/library/customsearch.googleapis.com で
#    Custom Search API を有効化し、APIキーを発行（1日100クエリまで無料）
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
